<Window x:Class="ProjectFlow_FNS.Views.ForgotPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Восстановление пароля" Height="600" Width="450"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid Background="#F5F5F5">
        <Border Background="White" Margin="30" CornerRadius="10" Padding="25">
            <StackPanel>
                <TextBlock Text="Восстановление пароля" FontSize="20" FontWeight="Bold"
                           Foreground="#005A9E" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                <TextBlock Text="Введите логин:"/>
                <TextBox x:Name="TxtLogin" Height="28" Margin="0,3,0,10"/>
                <Button Content="Найти вопрос" Width="150" Style="{StaticResource PrimaryButton}"
                        Click="BtnFindQuestion_Click"/>

                <TextBlock x:Name="TxtQuestion" Margin="0,15,0,5" FontWeight="SemiBold" Visibility="Collapsed"/>
                <TextBox x:Name="TxtAnswer" Height="28" Margin="0,3,0,8" Visibility="Collapsed"/>

                <TextBlock Text="Новый пароль:" x:Name="LblNewPass" Visibility="Collapsed"/>
                <PasswordBox x:Name="TxtNewPassword" Height="28" Margin="0,3,0,8" Visibility="Collapsed"/>

                <TextBlock x:Name="TxtMsg" Margin="0,10,0,0" HorizontalAlignment="Center"/>

                <Button Content="Сменить пароль" Style="{StaticResource PrimaryButton}"
                        Margin="0,15,0,5" Click="BtnReset_Click" Visibility="Collapsed" x:Name="BtnReset"/>
                <Button Content="Назад" Background="Transparent" Foreground="#005A9E"
                        BorderThickness="0" Click="BtnBack_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>