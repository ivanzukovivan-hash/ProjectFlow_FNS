<Window x:Class="ProjectFlow_FNS.Views.ReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Сводный отчет" Height="500" Width="700"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TxtTitle" Grid.Row="0" FontSize="20" FontWeight="Bold"
                   Foreground="#005A9E" Margin="0,0,0,15"/>

        <DataGrid x:Name="DgReport" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                <DataGridTextColumn Header="Задача" Binding="{Binding Title}" Width="*"/>
                <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="120"/>
                <DataGridTextColumn Header="Приоритет" Binding="{Binding Priority}" Width="90"/>
                <DataGridTextColumn Header="Исполнитель" Binding="{Binding Assignee}" Width="150"/>
                <DataGridTextColumn Header="Срок" Binding="{Binding Deadline, StringFormat={}{0:dd.MM.yyyy}}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <TextBlock x:Name="TxtSummary" VerticalAlignment="Center" Margin="0,0,15,0" FontWeight="SemiBold"/>
            <Button Content="Закрыть" Style="{StaticResource PrimaryButton}" Click="BtnClose_Click"/>
        </StackPanel>
    </Grid>
</Window>