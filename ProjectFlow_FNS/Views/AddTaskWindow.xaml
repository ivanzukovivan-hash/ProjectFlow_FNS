<Window x:Class="ProjectFlow_FNS.Views.AddTaskWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Новая задача" Height="500" Width="500"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="Создание новой задачи" FontSize="20" FontWeight="Bold"
                       Foreground="#005A9E" Margin="0,0,0,20"/>

            <TextBlock Text="Проект:"/>
            <ComboBox x:Name="CbProject" Height="28" Margin="0,3,0,10"/>

            <TextBlock Text="Название задачи:"/>
            <TextBox x:Name="TxtTitle" Height="28" Margin="0,3,0,10"/>

            <TextBlock Text="Описание:"/>
            <TextBox x:Name="TxtDescription" Height="70" TextWrapping="Wrap" Margin="0,3,0,10"/>

            <TextBlock Text="Приоритет:"/>
            <ComboBox x:Name="CbPriority" Height="28" Margin="0,3,0,10">
                <ComboBoxItem Content="Низкий"/>
                <ComboBoxItem Content="Средний" IsSelected="True"/>
                <ComboBoxItem Content="Высокий"/>
            </ComboBox>

            <TextBlock Text="Срок выполнения:"/>
            <DatePicker x:Name="DpDeadline" Height="28" Margin="0,3,0,20"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Отмена" Background="Gray" Foreground="White" Padding="15,8"
                        Margin="0,0,10,0" Click="BtnCancel_Click"/>
                <Button Content="Создать" Style="{StaticResource PrimaryButton}" Click="BtnSave_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>